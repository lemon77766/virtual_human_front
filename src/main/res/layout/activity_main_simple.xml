<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- SDK版本信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SDK版本: "
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_version_show"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="获取中..."/>
        </LinearLayout>

        <!-- 视频显示区域 -->
        <FrameLayout
            android:id="@+id/video_view_ava"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="#000000"
            android:layout_marginBottom="16dp"/>

        <!-- SDK初始化 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SDK初始化"
            android:textStyle="bold"
            android:background="#E0E0E0"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/et_app_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="APP ID"
                android:inputType="text"/>

            <EditText
                android:id="@+id/et_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="API Key"
                android:inputType="text"/>

            <EditText
                android:id="@+id/et_api_secret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="API Secret"
                android:inputType="textPassword"/>

            <TextView
                android:id="@+id/tv_init_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:text="点击初始化SDK"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- 虚拟人配置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="虚拟人配置"
            android:textStyle="bold"
            android:background="#E0E0E0"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/et_anchor_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="虚拟人ID (anchor_id)"
                android:inputType="text"/>

            <EditText
                android:id="@+id/et_vcn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="发音人 (vcn)"
                android:inputType="text"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="语义理解"/>

                <Switch
                    android:id="@+id/switch_nlp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="自动动作"/>

                <Switch
                    android:id="@+id/switch_auto_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 控制按钮 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="控制操作"
            android:textStyle="bold"
            android:background="#E0E0E0"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_create_player"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2196F3"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:text="创建播放器"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#4CAF50"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:text="启动虚拟人"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_one_key_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#673AB7"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:text="一键启动（初始化+播放器+虚拟人+录音）"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F44336"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:text="停止虚拟人"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>

        <!-- 文本交互 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="文本交互"
            android:textStyle="bold"
            android:background="#E0E0E0"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/et_input_box"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="输入要播报的文本..."
                android:gravity="top"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"/>

            <TextView
                android:id="@+id/tv_send_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FF9800"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:text="发送文本"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    <!-- 语音交互 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="语音交互"
        android:textStyle="bold"
        android:background="#E0E0E0"
        android:padding="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_create_recorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2196F3"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:text="创建录音器"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_start_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:text="开始录音"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_stop_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F44336"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:text="停止录音"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

        <!-- 音量控制 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="音量控制"
            android:textStyle="bold"
            android:background="#E0E0E0"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <SeekBar
                android:id="@+id/sb_player_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="音量: 50%"
                android:layout_gravity="center"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>