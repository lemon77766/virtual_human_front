<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 状态栏 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2196F3"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:text="准备启动虚拟人"
        android:gravity="center"
        android:textStyle="bold"/>

    <!-- 视频显示区域 -->
    <FrameLayout
        android:id="@+id/video_view_ava"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:layout_margin="8dp"/>

    <!-- 控制按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_start_avatar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="启动虚拟人"
            android:textColor="#FFFFFF"
            android:background="#4CAF50"
            android:padding="16dp"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_stop_avatar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="停止虚拟人"
            android:textColor="#FFFFFF"
            android:background="#F44336"
            android:padding="16dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:enabled="false"/>
    </LinearLayout>

    <!-- 文字交互区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <EditText
            android:id="@+id/et_input_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="输入文字与虚拟人对话..."
            android:padding="12dp"
            android:background="#F5F5F5"
            android:minHeight="48dp"
            android:maxLines="3"
            android:enabled="false"/>

        <Button
            android:id="@+id/btn_send_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送"
            android:textColor="#FFFFFF"
            android:background="#FF9800"
            android:padding="12dp"
            android:layout_marginStart="8dp"
            android:minWidth="80dp"
            android:enabled="false"/>
    </LinearLayout>

    <!-- 语音交互区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按住说话"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp"/>

        <ImageButton
            android:id="@+id/btn_voice_record"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_mic"
            android:background="@drawable/btn_voice_background"
            android:scaleType="centerInside"
            android:padding="20dp"
            android:enabled="false"
            android:contentDescription="语音交互按钮"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按住按钮进行语音交互"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

</LinearLayout>

