<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:layout_marginTop="28dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>


        <TextView
            android:id="@+id/privacy_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="隐私政策"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/home_text_primary"
            android:translationY="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/btn_ack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_privacy_card"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Section 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:translationY="20dp"
                        android:background="#FF5A5F" />
                    <TextView
                        android:id="@+id/section1_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. 引言"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#222222" />
                </LinearLayout>

                <TextView
                    android:id="@+id/section1_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="16sp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#666666" />

                <!-- Section 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:translationY="20dp"
                        android:background="#FF5A5F" />
                    <TextView
                        android:id="@+id/section2_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. 我们收集的信息"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#222222" />
                </LinearLayout>

                <TextView
                    android:id="@+id/section2_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="16sp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#666666" />

                <!-- Section 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:translationY="20dp"
                        android:background="#FF5A5F" />
                    <TextView
                        android:id="@+id/section3_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. 权限调用说明"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#222222" />
                </LinearLayout>

                <TextView
                    android:id="@+id/section3_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="16sp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#666666" />

                <!-- Section 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:translationY="20dp"
                        android:background="#FF5A5F" />
                    <TextView
                        android:id="@+id/section4_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. 信息使用与保护"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#222222" />
                </LinearLayout>

                <TextView
                    android:id="@+id/section4_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="16sp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#666666" />

                <!-- Section 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:translationY="20dp"
                        android:background="#FF5A5F" />
                    <TextView
                        android:id="@+id/section5_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5. 联系我们"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#222222" />
                </LinearLayout>

                <TextView
                    android:id="@+id/section5_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="16sp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#666666" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btn_ack"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_profile_emergency_button"
        android:gravity="center"
        android:text="我已知晓"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


