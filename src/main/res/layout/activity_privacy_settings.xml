<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/profile_bg"
    android:padding="16dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_back_privacy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/close" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="隐私设置"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/profile_text_title" />
    </LinearLayout>

    <!-- Info notification bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_profile_card"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_notification_icon"
            android:tint="@color/profile_accent_orange" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="个性化设置可根据您的偏好对虚拟人行为和内容进行优化，包含推荐与提醒等功能。"
            android:textColor="@color/profile_text_subtle"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Message settings row (clickable, opens message settings page) -->
    <LinearLayout
        android:id="@+id/row_message_settings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_profile_card"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="消息通知"
            android:textSize="16sp"
            android:textColor="@color/profile_text_title" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_profile_arrow_right" />
    </LinearLayout>

    <!-- Personalization switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_profile_card">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="启用个性化设置"
            android:textSize="16sp"
            android:textColor="@color/profile_text_title" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_personalization"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            app:showText="false" />
    </LinearLayout>

</LinearLayout>


