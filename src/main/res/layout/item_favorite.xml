<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_fav_cover"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_fav_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="类型"
                android:textSize="12sp"
                android:textColor="@color/profile_text_subtle" />

            <TextView
                android:id="@+id/tv_fav_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="标题"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/profile_text_title" />

            <TextView
                android:id="@+id/tv_fav_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="简介"
                android:textSize="13sp"
                android:textColor="@color/profile_text_subtle"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_fav_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="时间"
                android:textSize="12sp"
                android:textColor="@color/profile_text_subtle" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_fav_favorite"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_heart"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:contentDescription="取消收藏" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
